FUNCTION calculateProgress():
GET learner.uid
    FOR EACH learner:

        Calculate:
            completed tasks / total tasks × 100

        IF progress >= 70:
            Status = "On Track"

        ELSE IF progress >= 50:
            Status = "At Risk"

        ELSE:
            Status = "Needs Attention"

    Display learner progress


