2. Create Sample Learner Data

learners = [ ]

3. Calculate Learner Progress

FUNCTION calculateProgress(learner){

totalTasks = learner.totalTasks

completedTasks = learner.completedTasks

IF totalTasks == 0:

    RETURN 0

progress =
    (completedTasks / totalTasks) * 100

RETURN ROUND(progress)
}

4. Calculate Overall Learner Progress

FUNCTION calculateAverageProgress(){

totalProgress = 0

FOR EACH learner IN learners:

    progress = calculateProgress(learner)

    totalProgress = totalProgress + progress

averageProgress = totalProgress / learners.length 

RETURN ROUND(averageProgress)
}

5. Categorise Learner Progress

FUNCTION getProgressStatus(progress){

IF progress >= 70:

    RETURN "On Track"

ELSE IF progress >= 50:

    RETURN "At Risk"

ELSE:

    RETURN "Needs Attention"
}

6. Count Learners by Progress Status

FUNCTION countProgressStatuses(){

onTrack = 0

atRisk = 0

needsAttention = 0

FOR EACH learner IN learners:

    progress =
        calculateProgress(learner)

    status = getProgressStatus(progress)

    IF status == "On Track":

        onTrack = onTrack + 1

    ELSE IF status == "At Risk":

        atRisk = atRisk + 1

    ELSE:

        needsAttention =
            needsAttention + 1

RETURN {
    onTrack,
    atRisk,
    needsAttention
}

7. Create Task Data

tasks = [ ]

8. Calculate Task Statistics

FUNCTION calculateTaskStatistics(){

totalTasks = tasks.length

completedTasks = 0

outstandingTasks = 0

FOR EACH task IN tasks:

    IF task.completed == true:

        completedTasks = completedTasks + 1

    ELSE:

        outstandingTasks = outstandingTasks + 1

RETURN {
    totalTasks,
    completedTasks,
    outstandingTasks
}
}


