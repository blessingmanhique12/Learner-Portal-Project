20. Quick Action: Book Support Session

FUNCTION bookSupportSession(){

WHEN user clicks
"Book Session":

    OPEN support session form

    GET learner

    GET date

    GET time

    GET topic

    IF learner is empty
    OR date is empty
    OR time is empty:

        DISPLAY "Please complete all required fields"

        RETURN

    CREATE support session

    ADD session TO supportSessions

    DISPLAY "Support session booked successfully"

    displaySupportSessions()

    updateStatistics()
}

