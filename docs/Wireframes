16. View All Learners

FUNCTION viewAllLearners(){

WHEN user clicks
"View Full Progress Report":

    OPEN learners page

    DISPLAY all learners

    FOR EACH learner:

        progress = calculateProgress(learner)

        status = getProgressStatus(progress)

        DISPLAY:

            learner.name
            learner.totalTasks
            learner.completedTasks
            progress
            status
}

17. Quick Action: Add Task

FUNCTION addTask(){

WHEN user clicks
"Add Task":

    OPEN task form

    GET task title

    GET due date

    GET assigned learner

    IF title is empty:

        DISPLAY "Task title is required"

        RETURN

    CREATE new task

    ADD new task TO tasks

    DISPLAY "Task added successfully"

    updateStatistics()
}

