Pseudocode:
START

FUNCTION calculateProgress():
GET learner.uid
    FOR EACH learner:

        Calculate:
            completed tasks / total tasks × 100

        IF progress >= 70:
            Status = "On Track"

        ELSE IF progress >= 50:
            Status = "At Risk"

        ELSE:
            Status = "Needs Attention"

    Display learner progress


FUNCTION addTask():

    INPUT task title
    INPUT due date
    INPUT assigned learner

    IF required information is missing:

        Display error message

    ELSE:

        Display "Task added successfully"
        Add task to tasks list
        Refresh dashboard


FUNCTION uploadResources():

    INPUT resource title
    INPUT resource type
    INPUT due date

    IF required information is missing:

        Display "Input the required information!"

    ELSE:

       Display "Resource added successfully"
        Add resource to resources list
        Refresh dashboard


FUNCTION bookSupportSession():

    Get learner.uid
    INPUT date
    INPUT time
    INPUT topic

    IF required information is missing:

        Display "Input the required information"

    ELSE:

        Display "Support Session successfully booked"
        Add session to support sessions list
        Refresh dashboard


WHEN page loads:
FUNCTION displayDashboard():

    Display total number of learners

    Display completed and outstanding tasks

    Calculate and display learner progress

    Display upcoming assessments

    Display upcoming support sessions

    Display recent submissions

    Display notifications

    displayDashboard()

END