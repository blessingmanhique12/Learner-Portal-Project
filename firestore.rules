rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /registrations/{userId} {

      // A signed-in user can create their own profile.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;


      // A user can always read their own profile.
      //
      // A facilitator may also read learner profiles.
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          ||
          (
            resource.data.role == 'learner'
            && get(
              /databases/$(database)/documents/registrations/$(request.auth.uid)
            ).data.role == 'facilitator'
          )
        );


      // A user can update their own profile.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;


      // Do not allow users to delete profiles.
      allow delete: if false;
    }
  }
}